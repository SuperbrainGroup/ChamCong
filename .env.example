# ==============================================================================
# BIẾN MÔI TRƯỜNG DỰ ÁN CHẤM CÔNG SUPERBRAIN (PRJ-TIME-ONPREM-2026)
# ==============================================================================
# Đổi tên file này thành .env để nạp đè cấu hình mà không cần sửa file code.
# Tương thích Windows Server 2012 R2 và SQL Server 2008 / 2008 R2.

# 1. KẾT NỐI DATABASE (SQL Server 2008)
# Dùng Windows Authentication (SQL Server cục bộ):
DATABASE_CONNECTION_STRING="Server=.\\SQLEXPRESS;Database=ChamCong;Trusted_Connection=True;TrustServerCertificate=True;"
# Hoặc SQL Server Authentication (Server nội bộ / VPS):
# DATABASE_CONNECTION_STRING="Server=127.0.0.1,1433;Database=ChamCong;User Id=sa;Password=YourSecurePassword123!;TrustServerCertificate=True;"

# 2. BẢO MẬT XÁC THỰC JWT
# Khóa bí mật JWT (tối thiểu 256 bits / 32 ký tự, không chia sẻ công khai)
JWT_SECRET="Superbrain_ChamCong_Secret_Key_For_Jwt_Token_2026_Secure_Key_Long_Enough_256bits!"
JWT_ISSUER="ChamCongApp"
JWT_AUDIENCE="ChamCongUsers"
JWT_EXPIRY_HOURS=24

# 3. CHÍNH SÁCH CORS (Cho phép tất cả hoặc chỉ định danh sách domain cách nhau bằng dấu phẩy)
# Ví dụ: CORS_ALLOWED_ORIGINS="http://localhost:5173,http://192.168.1.100:5000" hoặc "*"
CORS_ALLOWED_ORIGINS="*"

# 4. FRONTEND CONFIGURATION (Nếu chạy dev Vite hoặc tách frontend sang port khác)
# Để trống nếu chạy chung trên IIS qua wwwroot
VITE_API_URL=""
